{
  "name": "gmail",
  "version": "1.0.0",
  "description": "Gmail integration — read, search, send and manage email via official Google MCP server (https://gmailmcp.googleapis.com/mcp/v1, OAuth2). Named pilot integration for the MCP marketplace.",
  "category": "Communication",
  "authentication": "Google OAuth 2.0",
  "tools": [
    "create_draft",
    "list_drafts",
    "get_thread",
    "get_message",
    "search_threads",
    "label_thread",
    "unlabel_thread",
    "apply_sensitive_thread_label",
    "list_labels",
    "label_message",
    "unlabel_message",
    "apply_sensitive_message_label",
    "create_label"
  ],
  "mcp": true,
  "setup": {
    "fields": [
      {
        "name": "GMAIL_CLIENT_ID",
        "label": "Google OAuth Client ID",
        "type": "text",
        "secret": true,
        "required": true,
        "hint": "GCP OAuth client ID"
      },
      {
        "name": "GMAIL_CLIENT_SECRET",
        "label": "Google OAuth Client Secret",
        "type": "password",
        "secret": true,
        "required": true,
        "hint": "GCP OAuth client secret"
      },
      {
        "name": "GMAIL_REFRESH_TOKEN",
        "label": "Google Refresh Token",
        "type": "password",
        "secret": true,
        "required": true,
        "hint": "Google OAuth refresh token for API access"
      }
    ]
  }
}
