{
  "name": "notion",
  "version": "1.0.0",
  "description": "Notion integration — pages, databases and blocks via the official Notion MCP server.",
  "category": "Productivity",
  "authentication": "Integration Token (ntn_)",
  "tools": [
    "API-get-user",
    "API-get-users",
    "API-get-self",
    "API-post-search",
    "API-get-block-children",
    "API-patch-block-children",
    "API-retrieve-a-block",
    "API-update-a-block",
    "API-delete-a-block",
    "API-retrieve-a-page",
    "API-patch-page",
    "API-post-page",
    "API-retrieve-a-page-property",
    "API-retrieve-a-comment",
    "API-create-a-comment",
    "API-query-data-source",
    "API-retrieve-a-data-source",
    "API-update-a-data-source",
    "API-create-a-data-source",
    "API-list-data-source-templates",
    "API-retrieve-a-database",
    "API-move-page",
    "API-retrieve-page-markdown",
    "API-update-page-markdown"
  ],
  "mcp": true,
  "setup": {
    "auth": {
      "method": "token",
      "label": "Notion Integration Token",
      "token_field": "NOTION_TOKEN",
      "hint": "Create an internal integration at notion.so/my-integrations and copy the `ntn_` token."
    }
  }
}
