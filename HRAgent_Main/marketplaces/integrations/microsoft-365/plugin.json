{
  "name": "microsoft-365",
  "version": "1.0.0",
  "description": "Microsoft 365 integration — Outlook mail/calendar, contacts, OneDrive and (org mode) Teams/SharePoint via ms-365-mcp-server.",
  "category": "Communication",
  "authentication": "Microsoft Entra ID (OAuth)",
  "tools": [
    "send_email",
    "get_emails",
    "get_calendar_events",
    "create_calendar_event",
    "get_contacts",
    "get_files",
    "search_files"
  ],
  "mcp": true,
  "setup": {
    "auth": {
      "method": "env",
      "label": "Microsoft Entra ID (OAuth)",
      "hint": "The M365 server performs its own MSAL OAuth using these Azure app credentials."
    },
    "fields": [
      {
        "name": "MS365_MCP_CLIENT_ID",
        "label": "Azure App Client ID",
        "type": "text",
        "required": true
      },
      {
        "name": "MS365_MCP_CLIENT_SECRET",
        "label": "Azure App Client Secret",
        "type": "password",
        "secret": true,
        "required": true
      },
      {
        "name": "MS365_MCP_TENANT_ID",
        "label": "Azure Tenant ID",
        "type": "text",
        "required": true
      }
    ]
  }
}
