# Copy to `.env.local` and fill in when wiring the real Azure backend.
# The mock workspace runs fully without any of these.

# FastAPI / Azure App Service base URL that the data layer will call
NEXT_PUBLIC_API_BASE_URL=https://your-app.azurewebsites.net

